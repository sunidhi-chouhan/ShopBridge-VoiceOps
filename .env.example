# From Nexconn Console → Key Management. Use the same App Key in the demo and the submission form.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Singapore is the default data center.
NEXCONN_API_BASE=https://api.sg-light-api.com
PORT=8787

# PostgreSQL (Neon). Required for production / Render. When unset locally, JSON data/store.json is used.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JSON data directory (local fallback only). Default: ./data
# SHOPBRIDGE_DATA_DIR=

# Demo sign-in password for local/hackathon use. Set locally; never commit a real .env.
SHOPBRIDGE_DEMO_PASSWORD=

# Allow POST /api/dev/reseed. Ignored when NODE_ENV=production.
# SHOPBRIDGE_ALLOW_RESEED=1

# Render / production: set NODE_ENV=production and DATABASE_URL (JSON fallback disabled).

# Shared demo: enables "Reset demo data" (account menu) for the demo accounts only.
# Set ONLY on the deployment designated as the public demo.
# SHOPBRIDGE_DEMO_RESET=1

# Apply additive SQL migrations automatically at boot (otherwise run `npm run db:migrate`).
# SHOPBRIDGE_AUTO_MIGRATE=1

# Optional AI reply drafts for support agents (Google AI Studio key, server-side only).
# GEMINI_API_KEY=
# GEMINI_MODEL=   # optional; default picks the newest available Gemini Flash model

# VoiceOps: Gemini Live model (measured fastest in docs/voiceops/PLAN.md)
GEMINI_LIVE_MODEL=gemini-3.8-live

# VoiceOps cost model (USD per audio minute; set to your current Gemini Live rates)
# GEMINI_COST_IN_PER_MIN=
# GEMINI_COST_OUT_PER_MIN=
# GEMINI_VAD_SILENCE_MS=300

# Backup key from a DIFFERENT Google Cloud project (separate quota); used automatically if the primary key fails
# GEMINI_API_KEY_BACKUP=
# GEMINI_LIVE_FALLBACK_MODELS=gemini-3.1-flash-live-preview
# Spend protection for a public demo
# VOICEOPS_MAX_CONCURRENT=3
# VOICEOPS_MAX_SESSIONS_PER_IP_DAY=40
# VOICEOPS_MAX_AUDIO_MIN_PER_DAY=180
# VOICEOPS_DEMO=1   # enables the Reset demo scenario button in production
# Cost defaults are Google list price for Gemini 3.8 Live audio, checked 2026-11-13: in 0.005, out 0.018 USD per minute
# Text model for support-reply drafting and the daily digest (the auto-picked newest Flash was unreliable)
GEMINI_MODEL=gemini-2.5-flash
